{
  "name": "@northgate/iris-widget",
  "version": "1.9.4",
  "description": "Iris virtual assistant chat widget. Angular Elements custom element <northgate-iris-widget>, shipped as one bundle for host pages to load at runtime.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "16.20.2",
    "npm": "8.19.4"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4205",
    "build": "ng build",
    "build:prod": "ng build --configuration production && node scripts/postbuild.js",
    "build:dev": "ng build --configuration development && node scripts/postbuild.js",
    "test": "ng test --browsers=ChromeHeadlessCI --code-coverage",
    "test:watch": "ng test",
    "lint": "ng lint",
    "harness": "node scripts/harness/serve.js",
    "harness:check": "node scripts/harness/check-mount.js"
  },
  "dependencies": {
    "@angular/animations": "15.2.10",
    "@angular/cdk": "15.2.9",
    "@angular/common": "15.2.10",
    "@angular/compiler": "15.2.10",
    "@angular/core": "15.2.10",
    "@angular/elements": "15.2.10",
    "@angular/forms": "15.2.10",
    "@angular/material": "15.2.9",
    "@angular/platform-browser": "15.2.10",
    "@angular/platform-browser-dynamic": "15.2.10",
    "@northgate/canopy-ui": "4.0.0",
    "rxjs": "7.5.7",
    "tslib": "2.4.1",
    "zone.js": "0.12.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "15.2.11",
    "@angular-eslint/builder": "15.2.1",
    "@angular-eslint/eslint-plugin": "15.2.1",
    "@angular-eslint/eslint-plugin-template": "15.2.1",
    "@angular-eslint/schematics": "15.2.1",
    "@angular-eslint/template-parser": "15.2.1",
    "@angular/cli": "15.2.11",
    "@angular/compiler-cli": "15.2.10",
    "@northgate/domain-fixtures": "1.6.0",
    "@types/jasmine": "4.0.3",
    "@types/node": "16.18.11",
    "@typescript-eslint/eslint-plugin": "5.43.0",
    "@typescript-eslint/parser": "5.43.0",
    "eslint": "8.28.0",
    "jasmine-core": "4.3.0",
    "karma": "6.4.1",
    "karma-chrome-launcher": "3.1.1",
    "karma-coverage": "2.2.0",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.0.0",
    "karma-junit-reporter": "2.0.1",
    "ngx-build-plus": "15.0.0",
    "typescript": "4.9.5"
  }
}